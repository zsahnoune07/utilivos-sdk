# Ed25519 private key path for utilivos build/sign (CLI .ubb archive signing).
# If both are empty, utilivos uses ~/.config/utilivos/keys/dev_ed25519_private.pem when present.
UTILIVO_PRIVATE_KEY=
# Same as UTILIVO_PRIVATE_KEY but useful in CI/Docker with mounted secrets (path only).
# UTILIVO_PRIVATE_KEY_FILE=/run/secrets/utilivo_ed25519_private.pem
#
# Plugin bundle ECDSA signing for the store/mobile app is server-side: BUNDLE_SIGNING_PRIVATE_KEY / BUNDLE_SIGNING_PRIVATE_KEY_FILE on utilivos-api, not here.
